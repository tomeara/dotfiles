{
    "mssql.connectionGroups": [
        {
            "name": "ROOT",
            "id": "ROOT"
        }
    ],
    "github.copilot.nextEditSuggestions.enabled": true,
    "typescript.tsserver.watchOptions": "vscode",
    "window.commandCenter": true,
    "editor.fontFamily": "'FiraCode Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.3,
    "editor.fontSize": 13,

    // VIM Settings
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.visualstar": true,
    "vim.easymotion": true,
    "vim.surround": true,
    "vim.ignorecase": true,
    
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [";"],
            "after": [":"]
        },
        {
            "before": ["\\"],
            "after": [";"]
        },
        {
            "before": ["<leader>", "<leader>"],
            "after": ["V"]
        },
        {
            "before": ["g", "h"],
            "commands": ["workbench.action.navigateBack"]
        }
    ],
    "vim.visualModeKeyBindings": [
        
        {
            "before": [";"],
            "after": [":"]
        },
        {
            "before": ["\\"],
            "after": [";"]
        },
        {
            "before": ["<leader>", "<leader>"],
            "after": ["<Esc>"]
        },
        {
            "before": ["J"],
            "commands": ["editor.action.moveLinesDownAction"]
        },
        {
            "before": ["K"],
            "commands": ["editor.action.moveLinesUpAction"]
        },
        {
            "before": ["<leader>", "y"],
            "after": ["\"", "+", "y"]
        },
        {
            "before": ["<leader>", "p"],
            "after": ["\"", "+", "p"]
        },
        {
            "before": ["<leader>", "P"],
            "after": ["\"", "+", "P"]
        },
        {
            "before": ["<Enter>"],
            "commands": ["editor.action.formatSelection"]
        }
    ],
    
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "/"],
            "commands": [":nohl"]
        },
        {
            "before": ["<leader>", "n"],
            "commands": ["workbench.action.toggleSidebarVisibility"]
        },
        {
            "before": ["<c-h>"],
            "after": ["<c-w>", "h"]
        },
        {
            "before": ["<c-j>"],
            "after": ["<c-w>", "j"]
        },
        {
            "before": ["<c-k>"],
            "after": ["<c-w>", "k"]
        },
        {
            "before": ["<c-l>"],
            "after": ["<c-w>", "l"]
        },
        {
            "before": ["<leader>", "t"],
            "commands": ["workbench.action.debug.start"]
        },
        {
            "before": ["<leader>", "s"],
            "commands": ["workbench.action.debug.run"]
        },
        {
            "before": ["<leader>", "l"],
            "commands": ["testing.rerunLastRun"]
        },
        {
            "before": ["<leader>", "a"],
            "commands": ["testing.runAll"]
        },
        {
            "before": ["<leader>", "o"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "p"],
            "after": ["\"", "+", "p"]
        },
        {
            "before": ["<leader>", "P"],
            "after": ["\"", "+", "P"]
        },
        {
            "before": ["<leader>", "r"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "R"],
            "commands": ["editor.action.refactor"]
        },
        {
            "before": ["<leader>", "b"],
            "commands": ["editor.debug.action.toggleBreakpoint"]
        },
        {
            "before": ["<leader>", "d"],
            "commands": ["editor.action.showHover"]
        },
        {
            "before": ["<leader>", "c", "l"],
            "commands": ["editor.action.commentLine"]
        },
        {
            "before": ["<leader>", "c", "u"],
            "commands": ["editor.action.commentLine"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "c", "l"],
            "commands": ["editor.action.commentLine"]
        },
        {
            "before": ["<leader>", "c", "u"],
            "commands": ["editor.action.commentLine"]
        }
    ],
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-f>": true,
        "<C-b>": true,
        "<C-u>": true
    },
    
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "line",
    "editor.scrollBeyondLastLine": false,
    // "editor.renderWhitespace": "all",
    "editor.rulers": [80, 120],
    "editor.formatOnSave": false,
    "editor.minimap.enabled": false,
    "editor.renderLineHighlight": "all",
    "editor.scrollBeyondLastColumn": 5,
    "editor.wordWrap": "off",
    "editor.folding": true,
    "editor.matchBrackets": "always",
    "files.autoSave": "onFocusChange",
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#444444"
    },
    "debug.javascript.autoAttachFilter": "always",
    "git.blame.statusBarItem.enabled": true,
    "git.blame.editorDecoration.enabled": true,
    "json.schemas": [

    ],
    "[json]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "editor.dropIntoEditor.preferences": [
        
    ],
    "python.analysis.typeCheckingMode": "standard",
    "chat.agentSkillsLocations": {
        "~/.claude/skills": false
    },
    "claudeCode.preferredLocation": "panel",
    "chat.tools.terminal.autoApprove": {
        "continue": true,
        "awk": true
    }
}